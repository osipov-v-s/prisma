{
  "name": "@prisma/desktop",
  "version": "1.0.0",
  "description": "Desktop-приложение ПРИЗМА для исследования визуальных предпочтений",
  "author": "Команда проекта ПРИЗМА",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n UI,DESKTOP -c blue,green \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && pnpm build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist/electron/main.js\"",
    "build": "vite build && pnpm build:electron",
    "package:windows": "pnpm build && electron-builder --win nsis",
    "build:electron": "tsc -p electron/tsconfig.json",
    "smoke": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 PRISMA_SKIP_SERVICE_START=1 PRISMA_SMOKE_TEST=1 electron dist/electron/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@prisma/ui": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "ru.prisma.research.desktop",
    "productName": "ПРИЗМА",
    "asar": true,
    "npmRebuild": false,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "extraResources": [
      { "from": "../../build/service", "to": "service", "filter": ["prisma-service.exe"] }
    ],
    "win": { "target": ["nsis"], "artifactName": "PRISMA-Desktop-${version}-Setup.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
