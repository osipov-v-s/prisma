{
  "name": "@prisma/desktop",
  "version": "2.0.3",
  "description": "Desktop-приложение ПРИЗМА для исследования визуальных предпочтений",
  "author": "Команда проекта ПРИЗМА",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n UI,DESKTOP -c blue,green \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && pnpm build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist/main/main.js\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && vite build && pnpm build:electron",
    "package:win": "electron-builder --win nsis",
    "package:mac": "electron-builder --mac dmg",
    "package:linux": "electron-builder --linux AppImage",
    "build:electron": "tsc -p main/tsconfig.json",
    "smoke": "cross-env PRISMA_SMOKE_TEST=1 electron dist/main/main.js",
    "smoke:runner": "cross-env PRISMA_RUNNER_SMOKE_TEST=1 electron dist/main/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p main/tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@prisma/ui": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "ru.prisma.research.desktop",
    "productName": "ПРИЗМА",
    "asar": true,
    "npmRebuild": false,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "extraResources": [
      { "from": "../../build/worker", "to": "worker", "filter": ["prisma-worker", "prisma-worker.exe"] }
    ],
    "win": { "target": ["nsis"], "artifactName": "PRISMA-Desktop-${version}-Setup.${ext}" },
    "mac": { "target": ["dmg"], "artifactName": "PRISMA-Desktop-${version}.${ext}" },
    "linux": { "target": ["AppImage"], "artifactName": "PRISMA-Desktop-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
